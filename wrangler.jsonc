{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamevaultbuild",
  "main": "src/index.js",
  "compatibility_date": "2026-05-18",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/prepare-large-assets.mjs"
  },
  "assets": {
    "directory": "./public"
  },
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "gamevault-unity-assets",
      "remote": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}