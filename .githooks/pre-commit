#!/bin/sh
# Auto-bump buildVersion when Unity build assets are committed.
# Enable once: git config core.hooksPath .githooks

STAGED=$(git diff --cached --name-only)

echo "$STAGED" | grep -qE '^public/(Build|StreamingAssets)/' || exit 0

echo "Unity build files changed — bumping buildVersion..."
node scripts/bump-build-version.mjs || exit 1
git add public/index.html
